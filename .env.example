# Armova: environment variables. Copy to .env for local runs, or set the same names in your host's dashboard (Runflare).
# Everything is optional unless marked REQUIRED. Never commit a real .env (it is git-ignored). Values below are placeholders.

# ---- Server ----
PORT=4000                       # Runflare usually injects PORT itself (e.g. 80); leave unset there
NODE_ENV=production             # production on the live site: hides dev-only OTP codes, caches more
PUBLIC_URL=https://armovaa.ir   # public address: used for SMS links and canonical/sitemap URLs (also settable in Admin -> Settings)

# ---- Storage ----
# Without DATABASE_URL the shop keeps its data in data/db.json. On a host with an ephemeral disk use PostgreSQL:
DATABASE_URL=postgres://user:password@host:5432/dbname   # PGHOST/PGUSER/... also work instead
PG_SSL=1                        # set to 1 when the database requires SSL
DATA_DIR=/data                  # persistent folder for db.json, thumbnails and the session secret (if mounted)
UPLOADS_DIR=/data/uploads       # persistent folder for product photos (catalog photos are restored at start anyway)
WARM_THUMBS=0                   # 1 = pre-build image thumbnails at start (slower boot, faster first visits)
AUTO_SEED=1                     # 0 = never auto-load the catalog when the database is empty

# ---- Security / first run ----
SESSION_SECRET=change-me-to-a-long-random-string   # signs login sessions; if empty one is generated into DATA_DIR/.secret
ADMIN_PASSWORD=change-me-before-first-run          # password of the first "owner" account (default admin123 if unset: change it!)

# ---- SMS (OTP login, order messages, campaigns) ----
SMS_PROVIDER=apiir              # apiir | kavenegar (can also be chosen in Admin -> Settings)
APIIR_TOKEN=                    # api.ir bearer token
KAVENEGAR_API_KEY=              # Kavenegar API key
KAVENEGAR_SENDER=               # Kavenegar line; empty = the demo line 0018018949161

# ---- Payments ----
ZIBAL_MERCHANT=                 # Zibal merchant ID (real card payments; "zibal" = sandbox). Setting it turns online payment on.
# Digipay installments (BNPL). All four are needed; setting DIGIPAY_CLIENT_ID turns the feature on.
DIGIPAY_CLIENT_ID=              # from the Digipay merchant panel
DIGIPAY_CLIENT_SECRET=          # from the Digipay merchant panel
DIGIPAY_USERNAME=               # API username from Digipay support
DIGIPAY_PASSWORD=               # API password from Digipay support
DIGIPAY_SANDBOX=0               # 0 = real environment (your panel credentials are real ones); leave unset for the test environment

# ---- Site verification (temporary) ----
ENAMAD_TITLE=                   # e.g. 23289698: forces this <title> on every page for Enamad/Zarinpal checks. REMOVE after approval.

# ---- Catalog sync from your computer (off unless set; remove after use) ----
SYNC_TOKEN=                     # 24+ random characters: enables /api/sync for scripts/push-catalog.js
SYNC_URL=                       # only for the push script on your computer, e.g. https://armovaa.ir
